    <parameter name="studentID" class="java.lang.Long"/>
    <parameter name="termID" class="java.lang.String"/>
    <parameter name="year" class="java.lang.Long"/>
    <parameter name="tenantId" class="java.lang.String"/>
    <parameter name="Logo" class="java.lang.String"/>
    <parameter name="SchoolName" class="java.lang.String">
        <defaultValueExpression><![CDATA["School Accounts Office"]]></defaultValueExpression>
    </parameter>
    <parameter name="SchoolAddress" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="SchoolMotto" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="SchoolContact" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>

    <!--
      One tenant-scoped query. A single-row summary (sm) carries the student and account
      figures; it is CROSS JOINed with a UNION of line items (li) so the tuition fee, the
      balance forward and every payment/transfer become one row each in the statement
      table. Every reference (finance, student, finance_transactions and the correlated
      balance-forward subquery) is scoped by tenant_id = $P{tenantId} because Jasper fills
      through a raw JDBC connection that bypasses the Hibernate tenant filter. The term is
      compared against the canonical enum string (TERM_1/2/3) normalized by the backend.

      Amount sign convention (so the payments reconcile with finance.paid_amount):
        INCOME  -> negative (money credited to the account reduces what is owed)
        EXPENSE PAYMENT_TRANSFER -> positive (money moved out increases what is owed)
      This mirrors the sample receipt where "Payment Received" shows -2,800 and
      "Transfer Out (Reversal)" shows +2,000, netting to the 800 actually paid.
    -->
    <queryString language="SQL">
        <![CDATA[
        SELECT
            sm.sName, sm.admNo, sm.gradeName, sm.streamName, sm.paymentMode,
            sm.currFee, sm.totalPaid, sm.totalBalance, sm.currTerm, sm.currTermYear,
            sm.balanceForward,
            li.sortOrder, li.description, li.tDate, li.rNo, li.amount AS lineAmount
        FROM
        (
            SELECT
                CONCAT_WS(' ', s.first_name, s.last_name) AS sName,
                s.admission_number AS admNo,
                s.grade_name AS gradeName,
                s.stream_name AS streamName,
                (SELECT ft3.payment_method
                   FROM finance_transactions ft3
                  WHERE ft3.student_id = f.student_id
                    AND ft3.term = f.term AND ft3.year = f.year
                    AND ft3.tenant_id = $P{tenantId}
                    AND ft3.transaction_type = 'INCOME'
                  ORDER BY ft3.transaction_date DESC, ft3.id DESC
                  LIMIT 1) AS paymentMode,
                f.total_fee_amount AS currFee,
                f.paid_amount AS totalPaid,
                f.balance AS totalBalance,
                f.term AS currTerm,
                f.year AS currTermYear,
                (SELECT COALESCE(SUM(f2.balance), 0)
                   FROM finance f2
                  WHERE f2.student_id = f.student_id
                    AND f2.tenant_id = $P{tenantId}
                    AND (
                         f2.year < f.year
                         OR (f2.year = f.year
                             AND CASE f2.term WHEN 'TERM_1' THEN 1 WHEN 'TERM_2' THEN 2 WHEN 'TERM_3' THEN 3 ELSE 99 END
                               < CASE f.term  WHEN 'TERM_1' THEN 1 WHEN 'TERM_2' THEN 2 WHEN 'TERM_3' THEN 3 ELSE 99 END)
                    )
                ) AS balanceForward,
                f.student_id AS sid, f.term AS fterm, f.year AS fyear
            FROM finance f
            JOIN student s ON s.id = f.student_id AND s.tenant_id = $P{tenantId}
            WHERE f.student_id = $P{studentID}
              AND f.term = $P{termID}
              AND f.year = $P{year}
              AND f.tenant_id = $P{tenantId}
        ) sm
        JOIN
        (
            -- 1) Tuition fee for the term
            SELECT 1 AS sortOrder,
                   CONCAT(REPLACE(f.term, '_', ' '), ' ', f.year, ' Tuition Fee') AS description,
                   CAST(NULL AS DATE) AS tDate,
                   CAST(NULL AS CHAR) AS rNo,
                   f.total_fee_amount AS amount,
                   f.student_id AS sid, f.term AS fterm, f.year AS fyear
            FROM finance f
            WHERE f.student_id = $P{studentID} AND f.term = $P{termID}
              AND f.year = $P{year} AND f.tenant_id = $P{tenantId}

            UNION ALL

            -- 2) Balance brought forward from prior terms
            SELECT 2 AS sortOrder,
                   'Balance Forward' AS description,
                   CAST(NULL AS DATE) AS tDate,
                   CAST(NULL AS CHAR) AS rNo,
                   (SELECT COALESCE(SUM(f2.balance), 0)
                      FROM finance f2
                     WHERE f2.student_id = f.student_id
                       AND f2.tenant_id = $P{tenantId}
                       AND (
                            f2.year < f.year
                            OR (f2.year = f.year
                                AND CASE f2.term WHEN 'TERM_1' THEN 1 WHEN 'TERM_2' THEN 2 WHEN 'TERM_3' THEN 3 ELSE 99 END
                                  < CASE f.term  WHEN 'TERM_1' THEN 1 WHEN 'TERM_2' THEN 2 WHEN 'TERM_3' THEN 3 ELSE 99 END)
                       )
                   ) AS amount,
                   f.student_id AS sid, f.term AS fterm, f.year AS fyear
            FROM finance f
            WHERE f.student_id = $P{studentID} AND f.term = $P{termID}
              AND f.year = $P{year} AND f.tenant_id = $P{tenantId}

            UNION ALL

            -- 3) Payments and transfers (one row each)
            SELECT 3 AS sortOrder,
                   CASE
                       WHEN ft.transaction_type = 'EXPENSE' THEN 'Transfer Out (Reversal)'
                       ELSE 'Payment Received'
                   END AS description,
                   ft.transaction_date AS tDate,
                   ft.reference AS rNo,
                   CASE WHEN ft.transaction_type = 'INCOME' THEN -ft.amount ELSE ft.amount END AS amount,
                   ft.student_id AS sid, ft.term AS fterm, ft.year AS fyear
            FROM finance_transactions ft
            WHERE ft.student_id = $P{studentID} AND ft.term = $P{termID}
              AND ft.year = $P{year} AND ft.tenant_id = $P{tenantId}
              AND (ft.transaction_type = 'INCOME'
                   OR (ft.transaction_type = 'EXPENSE' AND ft.category = 'PAYMENT_TRANSFER'))
        ) li
          ON li.sid = sm.sid AND li.fterm = sm.fterm AND li.fyear = sm.fyear
        ORDER BY li.sortOrder ASC, li.tDate ASC, li.rNo ASC
        ]]>
    </queryString>

