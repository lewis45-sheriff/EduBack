	<field name="admission_number" class="java.lang.String"/>
	<field name="full_name" class="java.lang.String"/>
	<field name="transport_type" class="java.lang.String"/>
	<field name="pickup_location" class="java.lang.String"/>
	<field name="is_missing" class="java.lang.Integer"/>
	<field name="boarding_state" class="java.lang.String"/>
	<field name="method" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<field name="captured_at" class="java.sql.Timestamp"/>
	<variable name="boardedCount" class="java.lang.Integer" calculation="Sum">
