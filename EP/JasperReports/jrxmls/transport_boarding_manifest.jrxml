	<parameter name="vehicleId" class="java.lang.Long"/>
	<parameter name="serviceDate" class="java.lang.String"/>
	<parameter name="leg" class="java.lang.String"/>
	<parameter name="tenantId" class="java.lang.String"/>
	<parameter name="Logo" class="java.lang.String"/>
	<parameter name="SchoolName" class="java.lang.String">
		<defaultValueExpression><![CDATA["EXCELLENCE ACADEMY"]]></defaultValueExpression>
	</parameter>
	<parameter name="SchoolMotto" class="java.lang.String">
		<defaultValueExpression><![CDATA["Nurturing Minds, Building Futures"]]></defaultValueExpression>
	</parameter>
	<parameter name="SchoolContact" class="java.lang.String">
		<defaultValueExpression><![CDATA["Tel: (123) 456-7890 | Email: info@excellenceacademy.edu"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[WITH target AS (
    SELECT
        CAST($P{leg} AS CHAR) AS leg,
        CASE
            WHEN $P{leg} IN ('MORNING_PICKUP','MORNING_DROPOFF') THEN 'MORNING'
            ELSE 'EVENING'
        END AS phase,
        CASE
            WHEN $P{leg} IN ('MORNING_PICKUP','MORNING_DROPOFF') THEN 'EVENING'
            ELSE 'MORNING'
        END AS other_phase
),
expected AS (
    /* Students assigned to this vehicle for the service date's term/year who are
       eligible for the requested leg under the "one trip per day" rule:
       TWO_WAY are always eligible; ONE_WAY are eligible only if they have NOT already
       boarded that day in the OTHER phase (first phase claims the day). */
    SELECT
        st.id                                   AS assignment_id,
        s.id                                    AS student_id,
        s.admission_number                      AS admission_number,
        CONCAT_WS(' ', s.first_name, s.last_name) AS full_name,
        st.transport_type                       AS transport_type,
        st.pickup_location                      AS pickup_location
    FROM student_transport st
    JOIN student s ON s.id = st.student_id
    CROSS JOIN target tg
    WHERE st.vehicle_id = $P{vehicleId}
      AND st.tenant_id  = $P{tenantId}
      AND s.tenant_id   = $P{tenantId}
      AND (
            st.transport_type = 'TWO_WAY'
            OR NOT EXISTS (
                SELECT 1
                FROM transport_boarding_event ob
                WHERE ob.student_id  = s.id
                  AND ob.service_date = $P{serviceDate}
                  AND ob.tenant_id   = $P{tenantId}
                  AND (
                        (tg.other_phase = 'MORNING' AND ob.leg IN ('MORNING_PICKUP','MORNING_DROPOFF'))
                     OR (tg.other_phase = 'EVENING' AND ob.leg IN ('EVENING_PICKUP','EVENING_DROPOFF'))
                  )
            )
      )
)
SELECT
    e.student_id,
    e.admission_number,
    e.full_name,
    e.transport_type,
    e.pickup_location,
    CASE WHEN be.id IS NULL THEN 1 ELSE 0 END AS is_missing,
    CASE WHEN be.id IS NULL THEN 'MISSING' ELSE 'BOARDED' END AS boarding_state,
    be.method     AS method,
    be.status     AS status,
    be.captured_at AS captured_at
FROM expected e
LEFT JOIN transport_boarding_event be
       ON be.student_id  = e.student_id
      AND be.service_date = $P{serviceDate}
      AND be.leg          = $P{leg}
      AND be.tenant_id    = $P{tenantId}
ORDER BY is_missing ASC, e.full_name ASC;]]>
	</queryString>
