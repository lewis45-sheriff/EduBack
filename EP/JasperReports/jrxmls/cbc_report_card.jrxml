            <staticText><reportElement mode="Opaque" backcolor="#111111" forecolor="#FFFFFF" x="197" y="52" width="161" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000503"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[STUDENT REPORT FORM]]></text></staticText>
            <line><reportElement x="20" y="78" width="515" height="1" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000506"/><graphicElement><pen lineWidth="1.2" lineColor="#111111"/></graphicElement></line>
