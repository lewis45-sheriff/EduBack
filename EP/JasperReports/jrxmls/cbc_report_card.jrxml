<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="cbc_report_card"
              language="java"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail"
              uuid="0b1e6d10-cbc0-4a10-9d0a-000000000001">

    <property name="com.jaspersoft.studio.unit." value="pixel"/>

    <!-- ============================= Styles =============================
         Black & white scheme to mirror the on-screen "Student Report Form":
         white background, black text/borders, light-grey section/table headers. -->
    <style name="TitleStyle" fontName="Arial" fontSize="18" isBold="true" forecolor="#111111"/>
    <style name="SubTitleStyle" fontName="Arial" fontSize="9" forecolor="#555555"/>
    <style name="SectionHeader" fontName="Arial" fontSize="10" isBold="true" forecolor="#111111"/>
    <style name="SectionNote" fontName="Arial" fontSize="8" isItalic="true" forecolor="#777777"/>
    <!-- Section title bar: light grey background, centred black bold text (like bg-muted). -->
    <style name="SectionBar" mode="Opaque" backcolor="#EFEFEF" fontName="Arial" fontSize="10" isBold="true" forecolor="#111111">
        <box><pen lineWidth="0.4" lineColor="#111111"/></box>
    </style>
    <!-- Table column header: light grey, dark grey uppercase text (like thead bg-muted). -->
    <style name="TableHeader" mode="Opaque" backcolor="#EFEFEF" forecolor="#444444" fontName="Arial" fontSize="8" isBold="true">
        <box><pen lineWidth="0.4" lineColor="#111111"/></box>
    </style>
    <style name="DetailStyle" fontName="Arial" fontSize="9" forecolor="#222222">
        <box><pen lineWidth="0.4" lineColor="#111111"/></box>
    </style>
    <style name="GroupCell" fontName="Arial" fontSize="9" isBold="true" forecolor="#111111">
        <box><pen lineWidth="0.4" lineColor="#111111"/></box>
    </style>
    <style name="InfoLabel" fontName="Arial" fontSize="8" isBold="true" forecolor="#555555"/>
    <style name="InfoValue" fontName="Arial" fontSize="10" isBold="true" forecolor="#111111"/>

    <!-- ============ Competency subdataset (evidence-based) ============ -->
    <subDataset name="Competencies" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000010">
        <parameter name="studentID" class="java.lang.Long"/>
        <parameter name="termID" class="java.lang.String"/>
        <parameter name="year" class="java.lang.Long"/>
        <parameter name="tenantId" class="java.lang.String"/>
        <queryString language="SQL">
            <![CDATA[
            SELECT c.name AS competencyName,
                   pl.label AS levelLabel,
                   COALESCE(ce.comment, ce.evidence_description) AS competencyComment
            FROM cbc_competency_evidence ce
            JOIN cbc_core_competency c ON c.id = ce.competency_id
            LEFT JOIN cbc_performance_level pl ON pl.id = ce.performance_level_id
            WHERE ce.student_id = $P{studentID}
              AND ce.term = $P{termID}
              AND ce.academic_year = $P{year}
              AND ce.tenant_id = $P{tenantId}
            ORDER BY c.sequence
            ]]>
        </queryString>
        <field name="competencyName" class="java.lang.String"/>
        <field name="levelLabel" class="java.lang.String"/>
        <field name="competencyComment" class="java.lang.String"/>
        <variable name="CompRowIdx" class="java.lang.Integer" calculation="Count">
            <variableExpression><![CDATA[$F{competencyName}]]></variableExpression>
        </variable>
    </subDataset>

    <!-- ============ Values subdataset (catalogue for the tenant's active version) ============ -->
    <subDataset name="Values" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000020">
        <parameter name="tenantId" class="java.lang.String"/>
        <queryString language="SQL">
            <![CDATA[
            SELECT v.name AS valueName
            FROM cbc_value v
            JOIN cbc_curriculum_version cv ON cv.id = v.curriculum_version_id
            WHERE v.tenant_id = $P{tenantId}
              AND v.status = 'ACTIVE'
              AND cv.status = 'ACTIVE'
            ORDER BY v.sequence
            ]]>
        </queryString>
        <field name="valueName" class="java.lang.String"/>
    </subDataset>

    <!-- ============ Individual assessments subdataset ============ -->
    <!-- Raw per-assessment marks from students_score (NOT the aggregate), ordered by
         learning area then assessment so the list can group rows under each area and
         print the area name only once per group. -->
    <subDataset name="IndividualAssessments" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000030">
        <parameter name="studentID" class="java.lang.Long"/>
        <parameter name="termID" class="java.lang.String"/>
        <parameter name="year" class="java.lang.Long"/>
        <parameter name="tenantId" class="java.lang.String"/>
        <queryString language="SQL">
            <![CDATA[
            SELECT asub.subject_name AS learningAreaName,
                   et.name          AS assessmentName,
                   COALESCE(ss.raw_score, ss.exam_score) AS score,
                   COALESCE(ss.maximum_score, et.max_score) AS maxScore,
                   CASE
                     WHEN COALESCE(ss.maximum_score, et.max_score) IS NULL
                          OR COALESCE(ss.maximum_score, et.max_score) = 0 THEN NULL
                     ELSE ROUND(COALESCE(ss.raw_score, ss.exam_score)
                          / COALESCE(ss.maximum_score, et.max_score) * 100, 1)
                   END AS percentage
            FROM students_score ss
            JOIN academic_subject asub ON asub.id = ss.academic_subject_id
            JOIN exam_type et          ON et.id = ss.exam_type_id
            WHERE ss.student_id = $P{studentID}
              AND ss.term = $P{termID}
              AND ss.year = $P{year}
              AND ss.tenant_id = $P{tenantId}
              AND COALESCE(ss.raw_score, ss.exam_score) IS NOT NULL
            ORDER BY asub.subject_name, et.name
            ]]>
        </queryString>
        <field name="learningAreaName" class="java.lang.String"/>
        <field name="assessmentName" class="java.lang.String"/>
        <field name="score" class="java.math.BigDecimal"/>
        <field name="maxScore" class="java.math.BigDecimal"/>
        <field name="percentage" class="java.math.BigDecimal"/>
        <variable name="RowIdx" class="java.lang.Integer" calculation="Count">
            <variableExpression><![CDATA[$F{assessmentName}]]></variableExpression>
        </variable>
        <!-- Group by learning area so the area label prints once per group. -->
        <group name="LearningAreaGroup">
            <groupExpression><![CDATA[$F{learningAreaName}]]></groupExpression>
        </group>
    </subDataset>

    <!-- ============ Competency COUNT subdataset (drives the "not yet assessed" note) ============ -->
    <subDataset name="CompetencyCount" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000040">
        <parameter name="studentID" class="java.lang.Long"/>
        <parameter name="termID" class="java.lang.String"/>
        <parameter name="year" class="java.lang.Long"/>
        <parameter name="tenantId" class="java.lang.String"/>
        <queryString language="SQL">
            <![CDATA[
            SELECT COUNT(*) AS competencyCount
            FROM cbc_competency_evidence ce
            WHERE ce.student_id = $P{studentID}
              AND ce.term = $P{termID}
              AND ce.academic_year = $P{year}
              AND ce.tenant_id = $P{tenantId}
            ]]>
        </queryString>
        <field name="competencyCount" class="java.lang.Long"/>
    </subDataset>

    <!-- Parameters supplied by ReportsService -->
    <parameter name="studentID" class="java.lang.Long"/>
    <parameter name="termID" class="java.lang.String"/>
    <parameter name="year" class="java.lang.Long"/>
    <parameter name="tenantId" class="java.lang.String"/>
    <parameter name="Logo" class="java.lang.String"/>
    <parameter name="SchoolName" class="java.lang.String">
        <defaultValueExpression><![CDATA["SCHOOL NAME"]]></defaultValueExpression>
    </parameter>
    <parameter name="SchoolAddress" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>

    <!-- ============ Main query: learning-area results from the CBC engine ============ -->
    <queryString language="SQL">
        <![CDATA[
        SELECT
            asub.subject_name           AS learningAreaName,
            CONCAT_WS(' ', s.first_name, s.last_name) AS studentFullName,
            s.admission_number          AS admissionNumber,
            g.name                      AS gradeName,
            CAST(cgr.year AS CHAR)      AS academicYear,
            cgr.term                    AS termName,
            cgr.normalized_score        AS normalizedScore,
            cgr.performance_points      AS performancePoints,
            COALESCE(pl.label, cgr.cbc_label) AS performanceLabel,
            pl.code                     AS performanceCode,
            cgr.teacher_comment         AS teacherComment,
            af.code                     AS frameworkCode
        FROM cbc_grade_result cgr
        JOIN student s        ON s.id = cgr.student_id
        JOIN academic_subject asub ON asub.id = cgr.academic_subject_id
        LEFT JOIN grade g     ON g.id = s.grade_id
        LEFT JOIN cbc_performance_level pl ON pl.id = cgr.performance_level_id
        LEFT JOIN cbc_assessment_framework af ON af.id = cgr.assessment_framework_id
        WHERE cgr.student_id = $P{studentID}
          AND cgr.term = $P{termID}
          AND cgr.year = $P{year}
          AND cgr.tenant_id = $P{tenantId}
        ORDER BY asub.subject_name ASC
        ]]>
    </queryString>

    <field name="learningAreaName" class="java.lang.String"/>
    <field name="studentFullName" class="java.lang.String"/>
    <field name="admissionNumber" class="java.lang.String"/>
    <field name="gradeName" class="java.lang.String"/>
    <field name="academicYear" class="java.lang.String"/>
    <field name="termName" class="java.lang.String"/>
    <field name="normalizedScore" class="java.math.BigDecimal"/>
    <field name="performancePoints" class="java.lang.Integer"/>
    <field name="performanceLabel" class="java.lang.String"/>
    <field name="performanceCode" class="java.lang.String"/>
    <field name="teacherComment" class="java.lang.String"/>
    <field name="frameworkCode" class="java.lang.String"/>

    <!-- ================================ Header ================================ -->
    <title>
        <band height="196" splitType="Stretch">
            <!-- Logo (left) -->
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="4" y="4" width="64" height="64" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000102">
                    <printWhenExpression><![CDATA[$P{Logo} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{Logo}]]></imageExpression>
            </image>
            <!-- School name (centred) -->
            <textField isBlankWhenNull="true">
                <reportElement style="TitleStyle" x="0" y="6" width="555" height="24" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000103"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="18" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{SchoolName} == null ? "" : $P{SchoolName}.toUpperCase()]]></textFieldExpression>
            </textField>
            <!-- School address (centred, under the name) -->
            <textField isBlankWhenNull="true">
                <reportElement style="SubTitleStyle" x="0" y="30" width="555" height="12" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000105"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{SchoolAddress}]]></textFieldExpression>
            </textField>
            <!-- Student name as the report title (centred), replacing "CBC LEARNER REPORT CARD" -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="46" width="555" height="20" forecolor="#111111" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000104"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{studentFullName}]]></textFieldExpression>
            </textField>
            <!-- "STUDENT REPORT FORM" black pill (centred), like the on-screen badge -->
            <staticText>
                <reportElement mode="Opaque" backcolor="#111111" forecolor="#FFFFFF" x="197" y="70" width="161" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000110"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[STUDENT REPORT FORM]]></text>
            </staticText>
            <!-- Black divider under the header -->
            <line>
                <reportElement x="0" y="94" width="555" height="1" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000111"/>
                <graphicElement><pen lineWidth="1.2" lineColor="#111111"/></graphicElement>
            </line>

            <!-- Learner identity block: bordered field cells (label: value), like the frontend grid -->
            <!-- Row 1 -->
            <staticText><reportElement style="InfoLabel" x="0" y="104" width="34" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000107"/><box leftPadding="4"><pen lineWidth="0.4" lineColor="#111111"/></box><textElement verticalAlignment="Middle"/><text><![CDATA[Name:]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement style="InfoValue" x="34" y="104" width="151" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000108"/><box leftPadding="4"><pen lineWidth="0.4" lineColor="#111111"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{studentFullName}]]></textFieldExpression></textField>
            <staticText><reportElement style="InfoLabel" x="185" y="104" width="48" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000109"/><box leftPadding="4"><pen lineWidth="0.4" lineColor="#111111"/></box><textElement verticalAlignment="Middle"/><text><![CDATA[Adm No:]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement style="InfoValue" x="233" y="104" width="105" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-00000000010a"/><box leftPadding="4"><pen lineWidth="0.4" lineColor="#111111"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{admissionNumber}]]></textFieldExpression></textField>
            <staticText><reportElement style="InfoLabel" x="338" y="104" width="40" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-00000000010b"/><box leftPadding="4"><pen lineWidth="0.4" lineColor="#111111"/></box><textElement verticalAlignment="Middle"/><text><![CDATA[Class:]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement style="InfoValue" x="378" y="104" width="177" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-00000000010c"/><box leftPadding="4"><pen lineWidth="0.4" lineColor="#111111"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{gradeName}]]></textFieldExpression></textField>
            <!-- Row 2 -->
            <staticText><reportElement style="InfoLabel" x="0" y="122" width="34" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000112"/><box leftPadding="4"><pen lineWidth="0.4" lineColor="#111111"/></box><textElement verticalAlignment="Middle"/><text><![CDATA[Year:]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement style="InfoValue" x="34" y="122" width="151" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000113"/><box leftPadding="4"><pen lineWidth="0.4" lineColor="#111111"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{academicYear}]]></textFieldExpression></textField>
            <staticText><reportElement style="InfoLabel" x="185" y="122" width="48" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000114"/><box leftPadding="4"><pen lineWidth="0.4" lineColor="#111111"/></box><textElement verticalAlignment="Middle"/><text><![CDATA[Term:]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement style="InfoValue" x="233" y="122" width="105" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000115"/><box leftPadding="4"><pen lineWidth="0.4" lineColor="#111111"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{termName} == null ? "" : $F{termName}.replace("TERM_", "Term ")]]></textFieldExpression></textField>
            <staticText><reportElement style="InfoLabel" x="338" y="122" width="40" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000116"/><box leftPadding="4"><pen lineWidth="0.4" lineColor="#111111"/></box><textElement verticalAlignment="Middle"/><text><![CDATA[Framework:]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement style="InfoValue" x="378" y="122" width="177" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000117"/><box leftPadding="4"><pen lineWidth="0.4" lineColor="#111111"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{frameworkCode} == null ? "-" : $F{frameworkCode}]]></textFieldExpression></textField>
        </band>
    </title>

    <!-- =============== Overall term performance (by learning area) =============== -->
    <columnHeader>
        <band height="56" splitType="Stretch">
            <staticText><reportElement style="SectionBar" x="0" y="8" width="555" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000200"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[OVERALL TERM PERFORMANCE]]></text></staticText>
            <staticText><reportElement style="TableHeader" x="0" y="30" width="28" height="22" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000201"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[#]]></text></staticText>
            <staticText><reportElement style="TableHeader" x="28" y="30" width="200" height="22" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000202"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[LEARNING AREA]]></text></staticText>
            <staticText><reportElement style="TableHeader" x="228" y="30" width="70" height="22" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000203"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[SCORE %]]></text></staticText>
            <staticText><reportElement style="TableHeader" x="298" y="30" width="170" height="22" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000204"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[PERFORMANCE LEVEL]]></text></staticText>
            <staticText><reportElement style="TableHeader" x="468" y="30" width="87" height="22" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000205"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[POINTS]]></text></staticText>
        </band>
    </columnHeader>

    <!-- Learning area rows (zebra striping via DetailStyle conditionalStyle) -->
    <detail>
        <band height="26" splitType="Stretch">
            <textField><reportElement style="DetailStyle" x="0" y="0" width="28" height="26" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000301"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression></textField>
            <textField><reportElement style="DetailStyle" x="28" y="0" width="200" height="26" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000302"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><textFieldExpression><![CDATA[$F{learningAreaName}]]></textFieldExpression></textField>
            <textField pattern="#,##0.0" isBlankWhenNull="true"><reportElement style="DetailStyle" x="228" y="0" width="70" height="26" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000303"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{normalizedScore}]]></textFieldExpression></textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement style="DetailStyle" x="298" y="0" width="170" height="26" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000304"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph leftIndent="3" rightIndent="3"/></textElement>
                <textFieldExpression><![CDATA[($F{performanceCode} == null ? "" : ($F{performanceCode} + " - ")) + ($F{performanceLabel} == null ? "" : $F{performanceLabel})]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="DetailStyle" x="468" y="0" width="87" height="26" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000305"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{performancePoints}]]></textFieldExpression></textField>
        </band>
    </detail>

    <!-- =============== Individual assessments + Competencies + Values + Remarks =============== -->
    <!-- Every element uses positionType="Float" so that when a list grows with its rows,
         the sections below are pushed down instead of overlapping. -->
    <summary>
        <band height="300" splitType="Stretch">

            <!-- ===== Individual term assessments, grouped by learning area ===== -->
            <staticText><reportElement style="SectionBar" positionType="Float" x="0" y="12" width="555" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000420"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[INDIVIDUAL TERM ASSESSMENTS]]></text></staticText>
            <staticText><reportElement style="TableHeader" positionType="Float" x="0" y="32" width="220" height="20" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000421"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[LEARNING AREA]]></text></staticText>
            <staticText><reportElement style="TableHeader" positionType="Float" x="220" y="32" width="190" height="20" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000422"/><textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement><text><![CDATA[ASSESSMENT]]></text></staticText>
            <staticText><reportElement style="TableHeader" positionType="Float" x="410" y="32" width="90" height="20" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000423"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[SCORE]]></text></staticText>
            <staticText><reportElement style="TableHeader" positionType="Float" x="500" y="32" width="55" height="20" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000424"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[%]]></text></staticText>

            <componentElement>
                <reportElement positionType="Float" x="0" y="52" width="555" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000425"/>
                <jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components"
                         xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd"
                         printOrder="Vertical">
                    <datasetRun subDataset="IndividualAssessments" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000426">
                        <datasetParameter name="studentID"><datasetParameterExpression><![CDATA[$P{studentID}]]></datasetParameterExpression></datasetParameter>
                        <datasetParameter name="termID"><datasetParameterExpression><![CDATA[$P{termID}]]></datasetParameterExpression></datasetParameter>
                        <datasetParameter name="year"><datasetParameterExpression><![CDATA[$P{year}]]></datasetParameterExpression></datasetParameter>
                        <datasetParameter name="tenantId"><datasetParameterExpression><![CDATA[$P{tenantId}]]></datasetParameterExpression></datasetParameter>
                    </datasetRun>
                    <jr:listContents height="18" width="555">
                        <!-- Learning area: printed only on the first row of each group -->
                        <textField isBlankWhenNull="true">
                            <reportElement style="GroupCell" x="0" y="0" width="220" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000427">
                                <printWhenExpression><![CDATA[$V{LearningAreaGroup_COUNT} == 1]]></printWhenExpression>
                            </reportElement>
                            <textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement>
                            <textFieldExpression><![CDATA[$F{learningAreaName}]]></textFieldExpression>
                        </textField>
                        <!-- Empty cell for continuation rows within the same group -->
                        <textField>
                            <reportElement style="DetailStyle" x="0" y="0" width="220" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-00000000042b">
                                <printWhenExpression><![CDATA[$V{LearningAreaGroup_COUNT} != 1]]></printWhenExpression>
                            </reportElement>
                            <textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement>
                            <textFieldExpression><![CDATA[""]]></textFieldExpression>
                        </textField>
                        <textField isBlankWhenNull="true">
                            <reportElement style="DetailStyle" x="220" y="0" width="190" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000428"/>
                            <textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement>
                            <textFieldExpression><![CDATA[$F{assessmentName}]]></textFieldExpression>
                        </textField>
                        <textField pattern="#,##0.##" isBlankWhenNull="true">
                            <reportElement style="DetailStyle" x="410" y="0" width="90" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000429"/>
                            <textElement textAlignment="Center" verticalAlignment="Middle"/>
                            <textFieldExpression><![CDATA[$F{score} + ($F{maxScore} == null ? "" : (" / " + $F{maxScore}))]]></textFieldExpression>
                        </textField>
                        <textField pattern="#,##0.0" isBlankWhenNull="true">
                            <reportElement style="DetailStyle" x="500" y="0" width="55" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-00000000042a"/>
                            <textElement textAlignment="Center" verticalAlignment="Middle"/>
                            <textFieldExpression><![CDATA[$F{percentage}]]></textFieldExpression>
                        </textField>
                    </jr:listContents>
                </jr:list>
            </componentElement>

            <!-- ===== Core competencies (evidence-based) ===== -->
            <staticText><reportElement style="SectionBar" positionType="Float" x="0" y="82" width="555" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000401"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[CORE COMPETENCIES]]></text></staticText>

            <componentElement>
                <reportElement positionType="Float" x="0" y="102" width="555" height="20" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000402"/>
                <jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components"
                         xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd"
                         printOrder="Vertical">
                    <datasetRun subDataset="Competencies" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000403">
                        <datasetParameter name="studentID"><datasetParameterExpression><![CDATA[$P{studentID}]]></datasetParameterExpression></datasetParameter>
                        <datasetParameter name="termID"><datasetParameterExpression><![CDATA[$P{termID}]]></datasetParameterExpression></datasetParameter>
                        <datasetParameter name="year"><datasetParameterExpression><![CDATA[$P{year}]]></datasetParameterExpression></datasetParameter>
                        <datasetParameter name="tenantId"><datasetParameterExpression><![CDATA[$P{tenantId}]]></datasetParameterExpression></datasetParameter>
                    </datasetRun>
                    <jr:listContents height="20" width="555">
                        <textField isBlankWhenNull="true">
                            <reportElement style="DetailStyle" x="0" y="0" width="220" height="20" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000404"/>
                            <textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement>
                            <textFieldExpression><![CDATA[$F{competencyName}]]></textFieldExpression>
                        </textField>
                        <textField isBlankWhenNull="true">
                            <reportElement style="DetailStyle" x="220" y="0" width="130" height="20" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000405"/>
                            <textElement textAlignment="Center" verticalAlignment="Middle"/>
                            <textFieldExpression><![CDATA[$F{levelLabel}]]></textFieldExpression>
                        </textField>
                        <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                            <reportElement style="DetailStyle" x="350" y="0" width="205" height="20" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000406"/>
                            <textElement verticalAlignment="Middle"><paragraph leftIndent="6" rightIndent="6"/></textElement>
                            <textFieldExpression><![CDATA[$F{competencyComment}]]></textFieldExpression>
                        </textField>
                    </jr:listContents>
                </jr:list>
            </componentElement>

            <!-- "Not yet assessed" note: single-row list, printed only when count == 0.
                 Not floating, so it never contributes to the float offset of the sections
                 below (it only shows content when the competency list above is empty, in
                 which case that list stays at its reserved height and nothing overlaps). -->
            <componentElement>
                <reportElement x="0" y="102" width="555" height="16" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000430"/>
                <jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components"
                         xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd"
                         printOrder="Vertical">
                    <datasetRun subDataset="CompetencyCount" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000431">
                        <datasetParameter name="studentID"><datasetParameterExpression><![CDATA[$P{studentID}]]></datasetParameterExpression></datasetParameter>
                        <datasetParameter name="termID"><datasetParameterExpression><![CDATA[$P{termID}]]></datasetParameterExpression></datasetParameter>
                        <datasetParameter name="year"><datasetParameterExpression><![CDATA[$P{year}]]></datasetParameterExpression></datasetParameter>
                        <datasetParameter name="tenantId"><datasetParameterExpression><![CDATA[$P{tenantId}]]></datasetParameterExpression></datasetParameter>
                    </datasetRun>
                    <jr:listContents height="16" width="555">
                        <textField isBlankWhenNull="true">
                            <reportElement style="SectionNote" x="0" y="0" width="555" height="16" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000432">
                                <printWhenExpression><![CDATA[$F{competencyCount} == null || $F{competencyCount} == 0]]></printWhenExpression>
                            </reportElement>
                            <textElement verticalAlignment="Middle"><paragraph leftIndent="6"/></textElement>
                            <textFieldExpression><![CDATA["Competencies have not yet been assessed for this learner this term."]]></textFieldExpression>
                        </textField>
                    </jr:listContents>
                </jr:list>
            </componentElement>

            <!-- ===== School core values (catalogue) ===== -->
            <staticText><reportElement style="SectionBar" positionType="Float" x="0" y="132" width="555" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000407"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[SCHOOL CORE VALUES]]></text></staticText>
            <staticText><reportElement style="SectionNote" positionType="Float" x="0" y="150" width="555" height="12" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000433"/><textElement><paragraph leftIndent="6"/></textElement><text><![CDATA[The CBC values the school promotes. Per-learner value observations are not recorded.]]></text></staticText>

            <componentElement>
                <reportElement positionType="Float" x="0" y="164" width="555" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-000000000408"/>
                <jr:list xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components"
                         xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd"
                         printOrder="Horizontal">
