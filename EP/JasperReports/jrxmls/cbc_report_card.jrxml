                        <datasetParameter name="tenantId"><datasetParameterExpression><![CDATA[$P{tenantId}]]></datasetParameterExpression></datasetParameter>
                    </datasetRun>
                    <jr:listContents height="24" width="138">
                        <textField isBlankWhenNull="true">
                            <reportElement mode="Opaque" backcolor="#F4F4F4" x="2" y="2" width="134" height="20" forecolor="#111111" uuid="0b1e6d10-cbc0-4a10-9d0a-00000000040a"/>
                            <box><pen lineWidth="0.5" lineColor="#111111"/></box>
                            <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement>
                            <textFieldExpression><![CDATA[$F{valueName}]]></textFieldExpression>
                        </textField>
                    </jr:listContents>
                </jr:list>
            </componentElement>

            <!-- ===== Class teacher's remarks ===== -->
            <staticText><reportElement style="SectionBar" positionType="Float" x="0" y="196" width="555" height="18" uuid="0b1e6d10-cbc0-4a10-9d0a-00000000040e"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[CLASS TEACHER'S REMARKS]]></text></staticText>
            <frame>
                <reportElement positionType="Float" mode="Opaque" x="0" y="214" width="555" height="50" backcolor="#FFFFFF" uuid="0b1e6d10-cbc0-4a10-9d0a-00000000040d"/>
                <box><pen lineWidth="0.4" lineColor="#111111"/></box>
                <textField evaluationTime="Report" textAdjust="StretchHeight" isBlankWhenNull="true">
                    <reportElement x="12" y="10" width="531" height="30" forecolor="#000000" uuid="0b1e6d10-cbc0-4a10-9d0a-00000000040f"/>
                    <textElement verticalAlignment="Top"><font fontName="Arial" size="10"/></textElement>
                    <textFieldExpression><![CDATA[$F{teacherComment} == null ? "No class teacher remark has been recorded for this learner this term." : $F{teacherComment}]]></textFieldExpression>
                </textField>
